rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'staff';
    }
    function isCrew() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'crew';
    }
    function isAssignedToJob(jobId) {
      return isCrew() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.get('assignedCrew', []);
    }

    match /jobs/{jobId}/receipts/{fileName} {
      allow read: if isStaff();
      allow write: if isStaff()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    match /jobs/{jobId}/activity/{fileName} {
      allow read: if isStaff() || isAssignedToJob(jobId);
      allow create: if (isStaff() || isAssignedToJob(jobId))
        && resource == null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if isStaff();
    }

    match /jobs/{jobId}/contract/{fileName} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
